#!/usr/bin/env python3
"""Which connected monitors say they can show HDR, from their EDID.

    hdr        {"DP-1": true, "HDMI-A-1": false}

A monitor can when a CTA-861 extension of its EDID holds the HDR Static
Metadata Data Block (extended tag 6) with the SMPTE ST 2084 (PQ) transfer
function among its EOTFs: what HDR10 needs. Whether the compositor will turn
it on is the compositor's business; this is what the screen itself claims,
read the same way under every compositor. Connectors with no EDID (nothing
plugged in) are left out.
"""
import glob
import json
import os


def pq(edid):
    for e in range(1, len(edid) // 128):
        block = edid[e * 128:(e + 1) * 128]
        if block[0] != 0x02:  # not a CTA-861 extension
            continue
        end = block[2] if block[2] >= 4 else 4
        i = 4
        while i < end and i < len(block):
            tag, length = block[i] >> 5, block[i] & 0x1F
            if tag == 7 and length >= 2 and block[i + 1] == 0x06:
                return bool(block[i + 2] & 0x04)
            i += 1 + length
    return False


out = {}
for path in sorted(glob.glob("/sys/class/drm/card*-*/edid")):
    try:
        with open(path, "rb") as f:
            edid = f.read()
    except OSError:
        continue
    if len(edid) < 128:
        continue
    connector = os.path.basename(os.path.dirname(path)).split("-", 1)[1]
    out[connector] = out.get(connector, False) or pq(edid)
print(json.dumps(out))
