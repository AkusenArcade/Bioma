#!/usr/bin/env bash
# Keep the greeter's copy of the desktop up to date.
#
#     greeter-sync [directory]     default: $BIOMA_GREETER_DIR, or /var/lib/bioma-greeter
#
# The greeter runs as the `greeter` user before anyone is logged in, and cannot
# read anybody's home. So it runs from a copy, kept in a directory the user
# writes and the greeter reads — owned by the user, group `greeter`, setgid, so
# everything written into it is readable by that group:
#
#     sudo install -d -m 2750 -o "$USER" -g greeter /var/lib/bioma-greeter
#
# The copy holds, under `live/`:
#
#   shell/         genoma/, Bioma on Genoma's greeter among it, and the
#                  assets and configuration it reads; the Quickshell
#                  version's greeter.qml too, from a checkout that still has
#                  it (quickshell/, the backup)
#   bin/           Genoma's runtime
#   config/bioma/  the configuration layers, the wallpaper's state, the
#                  palette and the user's own palettes — XDG_CONFIG_HOME points
#                  here, so the greeter reads the user's own appearance through
#                  the ordinary paths
#   wallpapers/    the images the wallpaper state names
#   data/fonts/    Bioma's two faces, when they are installed in the home
#   data/icons/    the cursor theme, when it is installed in the home
#   niri/          the outputs, the keyboard and the cursor, so the greeter's
#                  niri lays the screens out as the session does — a spanned
#                  wallpaper has to cross the same seam — and the password is
#                  typed on the same layout
#   niri.kdl       the greeter's compositor configuration
#   user.json      who to greet, and the session to start
#   avatar         their picture
#
# It is built beside the old one and swapped in whole, so a greeter starting
# during a sync sees one copy or the other, never half of each. The shell runs
# this by itself when any of it changes (services/GreeterSync.qml).
set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
dest="${1:-${BIOMA_GREETER_DIR:-/var/lib/bioma-greeter}}"
config="${XDG_CONFIG_HOME:-$HOME/.config}"

if [ ! -d "$dest" ] || [ ! -w "$dest" ]; then
    echo "greeter-sync: $dest is not a directory this user can write." >&2
    echo "Create it once with:  sudo install -d -m 2750 -o \"$USER\" -g greeter $dest" >&2
    exit 1
fi

# Readable by the directory's group, and by nobody else.
umask 027

next="$dest/next"
live="$dest/live"
rm -rf "$next"
mkdir -p "$next"/{shell,config/bioma/generated,wallpapers,data/fonts,niri}

# ---- The shell ----------------------------------------------------------------

mkdir -p "$next/shell/config" "$next/shell/scripts"
cp -r "$here/assets" "$next/shell/"
qs="$here/quickshell"
if [ -f "$qs/greeter.qml" ] && command -v qs >/dev/null 2>&1; then
    mkdir -p "$next/shell/cells"
    cp -r "$qs/core" "$qs/components" "$qs/greeter" "$next/shell/"
    cp "$qs/greeter.qml" "$next/shell/"
    cp "$qs/cells/Registry.qml" "$next/shell/cells/"
fi
cp "$here/config/default.json" "$next/shell/config/"
cp -r "$here/config/palettes" "$next/shell/config/"
cp "$here/scripts/greeter-session" "$next/shell/scripts/"

# Bioma on Genoma's greeter, when the configuration gives it the greeter
# (`"greeter": { "runtime": "genoma" }`, or the whole shell; see
# `scripts/runtime`): its Luau, and Genoma's runtime,
# stripped, under bin/. The runtime is $GENOMA_BIN or `genoma` on the PATH;
# with neither, the one the last copy carried is kept, so a sync from a
# shell that does not know where Genoma is never takes it away. Without a
# runtime at all there is the Quickshell greeter from a checkout, and
# greetd's plain agreety otherwise (scripts/greeter-session).
runtime="$("$here/scripts/runtime" greeter)"
if { [ "$runtime" = genoma ] || [ ! -f "$next/shell/greeter.qml" ]; } && [ -d "$here/genoma" ]; then
    mkdir -p "$next/bin"
    cp -r "$here/genoma" "$next/shell/"
    bin="${GENOMA_BIN:-$(command -v genoma || true)}"
    if [ -n "$bin" ] && [ -x "$bin" ]; then
        strip -o "$next/bin/genoma" "$bin" 2>/dev/null || cp "$bin" "$next/bin/genoma"
    elif [ -x "$live/bin/genoma" ]; then
        cp "$live/bin/genoma" "$next/bin/genoma"
    fi
fi

# ---- The configuration ----------------------------------------------------------

for file in override.json generated/palette.json; do
    if [ -f "$config/bioma/$file" ]; then
        cp "$config/bioma/$file" "$next/config/bioma/$file"
    fi
done

# The user's own palettes, where the greeter's Theme looks for them first.
mkdir -p "$next/config/bioma/palettes"
if [ -d "$config/bioma/palettes" ]; then
    find "$config/bioma/palettes" -maxdepth 1 -name '*.json' -type f \
        -exec cp {} "$next/config/bioma/palettes/" \;
fi

# The wallpaper's state, with its images copied and its paths pointed at the
# copies, and everything the greeter needs to know about the user.
python3 - "$config/bioma/wallpaper.json" "$next" "$live" "$USER" <<'PY'
import json, os, pwd, shutil, sys

state_path, next_dir, live_dir, login = sys.argv[1:5]
home = os.path.expanduser("~")

def expand(path):
    if path.startswith("~/"):
        return home + path[1:]
    if path.startswith("$HOME"):
        return home + path[5:]
    return path

copied = {}
def copy_image(path):
    path = expand(path)
    if not path or not os.path.isfile(path):
        return ""
    if path not in copied:
        name = f"{len(copied)}-{os.path.basename(path)}"
        shutil.copyfile(path, os.path.join(next_dir, "wallpapers", name))
        copied[path] = os.path.join(live_dir, "wallpapers", name)
    return copied[path]

try:
    state = json.load(open(state_path))
except (OSError, ValueError):
    state = {}

out = {"mode": state.get("mode", "fill"), "path": copy_image(state.get("path", ""))}
out["perMonitorPaths"] = {name: copy_image(p) for name, p in (state.get("perMonitorPaths") or {}).items()}
json.dump(out, open(os.path.join(next_dir, "config/bioma/wallpaper.json"), "w"), indent=2)

# Who. The full name is the first field of GECOS, as the System cell shows it.
entry = pwd.getpwnam(login)
full_name = entry.pw_gecos.split(",")[0].strip() or login

avatar = ""
for candidate in (f"/var/lib/AccountsService/icons/{login}",
                  os.path.join(home, ".face"), os.path.join(home, ".face.icon")):
    if os.path.isfile(candidate):
        shutil.copyfile(candidate, os.path.join(next_dir, "avatar"))
        avatar = "avatar"
        break

# The session the user is in now is the one to start: niri's own launcher.
json.dump({"login": login, "fullName": full_name, "avatar": avatar,
           "session": ["niri-session"]},
          open(os.path.join(next_dir, "user.json"), "w"), indent=2)
PY

# ---- The faces ----------------------------------------------------------------------

# Only the ones installed in the home: a system font the greeter already has.
for family in Spectral Orbitron; do
    fc-list : family file 2>/dev/null | grep -i ": *$family" | cut -d: -f1 | while read -r file; do
        case "$file" in
            "$HOME"/*) cp "$file" "$next/data/fonts/" ;;
        esac
    done
done

# ---- The compositor ------------------------------------------------------------------

niri_config="$config/niri"
for part in outputs.kdl bioma-keyboard.kdl bioma-cursor.kdl; do
    target="$next/niri/$part"
    if [ -f "$niri_config/$part" ]; then
        cp "$niri_config/$part" "$target"
    else
        : > "$target"
    fi
done

# What the greeter's niri starts: Bioma on Genoma when the copy carries its
# runtime, then the Quickshell greeter if the copy has one, each taking over
# when the one before ends in an error. When the last of them fails it leaves
# a mark, and scripts/greeter-session hands the login to agreety once niri
# has ended. Either way niri ends with it.
# Unquoted: the line goes inside a KDL string. The runtime directory is
# scripts/greeter-session's, with no spaces in it.
failed='touch $XDG_RUNTIME_DIR/bioma-greeter-failed'
start="$failed"
if [ -f "$next/shell/greeter.qml" ]; then
    start="BIOMA_GREETER_DIR=$live qs -p $live/shell/greeter.qml || $start"
fi
if [ -x "$next/bin/genoma" ]; then
    # Run under the greeter's own name: the process takes the name it is
    # started by, and Genoma is only the toolkit.
    ln -sfn genoma "$next/bin/bioma-greeter"
    start="BIOMA_GREETER_DIR=$live $live/bin/bioma-greeter $live/shell/genoma greeter.luau || $start"
fi
sed -e "s|@GREETER@|$live|g" -e "s#@START@#$start#" "$here/config/niri/greeter.kdl.in" > "$next/niri.kdl"

# ---- The cursor ----------------------------------------------------------------------

# The theme bioma-cursor.kdl names, and those it inherits from, when they are
# installed in the home: the greeter cannot read the home, and one the system
# has is there already. Bioma's own cursors always live in the home, under a
# slot name that inherits the theme itself (scripts/cursors), so both come.
# scripts/greeter-session puts this directory on the greeter's cursor path.
mkdir -p "$next/data/icons"
theme="$(sed -n 's/^[[:space:]]*xcursor-theme[[:space:]]*"\(.*\)".*/\1/p' "$niri_config/bioma-cursor.kdl" 2>/dev/null | tail -1 || true)"
while [ -n "$theme" ] && [ ! -e "$next/data/icons/$theme" ]; do
    found=""
    for root in "${XDG_DATA_HOME:-$HOME/.local/share}/icons" "$HOME/.icons"; do
        if [ -d "$root/$theme" ]; then
            found="$root/$theme"
            break
        fi
    done
    [ -n "$found" ] || break
    cp -R "$found" "$next/data/icons/"
    theme="$(sed -n 's/^Inherits=\([^,]*\).*/\1/p' "$found/index.theme" 2>/dev/null | head -1)"
done

# The directory's group reads everything; the setgid bit already gave it the
# group.
chmod -R g+rX "$next"

# ---- Swap ------------------------------------------------------------------------------

rm -rf "$dest/old"
[ -d "$live" ] && mv "$live" "$dest/old"
mv "$next" "$live"
rm -rf "$dest/old"
