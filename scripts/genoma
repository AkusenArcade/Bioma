#!/usr/bin/env bash
#
# Bioma on Genoma (genoma/PORT.md), started beside the Quickshell shell
# while the port goes surface by surface: it draws the configuration's
# blocks marked `"runtime": "genoma"`, and `scripts/bioma` leaves them out.
#
# Genoma's runtime is `$GENOMA_BIN`, else `genoma` on the PATH. Until Genoma
# is packaged, GENOMA_BIN points at its build.
set -eu
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
bin="${GENOMA_BIN:-$(command -v genoma || true)}"
if [ -z "$bin" ] || [ ! -x "$bin" ]; then
    echo "genoma: no runtime; set GENOMA_BIN to Genoma's build (…/Genoma/target/release/genoma)" >&2
    exit 1
fi
# Calls reach it on its own socket, not on another Genoma interface's:
#   scripts/genoma ipc cell toggle <domain> [output]
export GENOMA_IPC="${GENOMA_IPC:-bioma}"
if [ "${1:-}" = ipc ]; then
    shift
    exec "$bin" ipc "$@"
fi
# What pacman had installed of what this process runs, when it started:
# Bioma from the package's directory, Genoma from the package's binary. The
# shell restarts itself when that changes (genoma/services/upgrade.luau); a
# checkout or a build of one's own lists nothing for its side.
packages=""
if [ -d /var/lib/pacman/local ]; then
    want=()
    [ "$here" = /usr/share/bioma ] && want+=(bioma-shell)
    [ "$(readlink -f "$bin")" = /usr/bin/genoma ] && want+=(genoma)
    for name in ${want[@]+"${want[@]}"}; do
        for dir in /var/lib/pacman/local/"$name"-*; do
            entry="${dir##*/}"
            [ "${entry%-*-*}" = "$name" ] && packages="$packages${packages:+ }$entry"
        done
    done
fi
export BIOMA_PACKAGES="$packages"
# Named for what it runs: Genoma is the toolkit, the process is Bioma.
exec -a bioma "$bin" "$here/genoma" "$@"
