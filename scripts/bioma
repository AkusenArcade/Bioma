#!/usr/bin/env bash
# Bioma, started the way it wants to be started.
#
# The one thing this adds is the Qt platform theme. Bioma draws every pixel it
# shows, so a theme plugin has nothing to style here — except the file picker
# the session cell opens, which is Qt's `FileDialog`. Qt asks the platform
# theme for a native dialog and draws its own when there is none, and `qt6ct`,
# which is a common choice for everything else on a machine, provides none. So
# a picker that should be the desktop's own comes up looking like nothing else
# on the screen.
#
# `xdgdesktopportal` hands the request to xdg-desktop-portal, which is the
# desktop's real file chooser. It is set for this process only: whatever the
# session uses for every other Qt application stays as it was.
set -eu

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

# What the session had is kept beside it: the shell's children inherit its
# environment, and an application started from the launcher is one of the
# "every other" above. `scripts/launch` puts it back.
export BIOMA_SESSION_PLATFORMTHEME="${QT_QPA_PLATFORMTHEME-}"
export QT_QPA_PLATFORMTHEME="${BIOMA_PLATFORMTHEME:-xdgdesktopportal}"

# And the icon theme, which that platform theme does not pass on: without it Qt
# looks in hicolor alone, so an application's own icon is found and a themed
# one — a folder, a device — is not. Quickshell reads the theme from
# `QS_ICON_THEME` once, when it starts; the theme cell's DESKTOP capsule sets
# the desktop's, and the shell's own icons follow it at the next start.
if [ -z "${QS_ICON_THEME:-}" ] && command -v gsettings >/dev/null 2>&1; then
    QS_ICON_THEME="$(gsettings get org.gnome.desktop.interface icon-theme 2>/dev/null | tr -d "'")"
    export QS_ICON_THEME
fi

# And the graphics backend. Qt Quick draws through OpenGL unless told
# otherwise, and through Vulkan the same desktop cost a third less CPU and
# 70 MB less memory (10.1% of a core and 579 MB against 6.5% and 511 MB, at
# rest, 2026-10-28): most of what OpenGL spent was in the driver, once per
# window. Qt does not fall back if Vulkan fails, so `scripts/vulkan` asks
# first, and a machine without a Vulkan driver keeps OpenGL. What the session
# had is kept beside it, as with the platform theme.
export BIOMA_SESSION_RHI_BACKEND="${QSG_RHI_BACKEND-}"
if [ -n "${BIOMA_RHI_BACKEND:-}" ]; then
    export QSG_RHI_BACKEND="$BIOMA_RHI_BACKEND"
elif "$here/scripts/vulkan" 2>/dev/null; then
    export QSG_RHI_BACKEND=vulkan
else
    export QSG_RHI_BACKEND=opengl
fi

# Through Vulkan, a frame is presented without waiting for the display's
# turn. Waiting froze the shell when a monitor went away (2026-10-28): the
# render thread waited inside the driver's present for a frame callback the
# compositor never sends to a gone output's surface, while the main thread,
# closing that surface, waited for the render thread. OpenGL never waited, and
# the animations are timed by Qt's own timer either way, so nothing on screen
# moves differently; at rest the cost was the same (5.7% of a core).
export BIOMA_SESSION_NO_VSYNC="${QSG_NO_VSYNC-}"
if [ "$QSG_RHI_BACKEND" = vulkan ]; then
    export QSG_NO_VSYNC=1
fi

exec qs -p "$here/shell.qml" "$@"
