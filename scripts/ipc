#!/usr/bin/env bash
# One way into the running Bioma, whichever runtime draws it.
#
#     ipc <target> <function> [argument…]      e.g.  ipc cell toggle vitals
#
# The targets and functions are shell.qml's IpcHandlers, which Bioma on
# Genoma answers the same (genoma/ipc.luau). Keybinds, `scripts/key` and the
# settings' Keybinds page call this rather than `qs ipc call`, so a key keeps
# working across the switch to Genoma (M6 step 7a). The configuration says
# which runtime is the shell (`scripts/runtime`); Genoma answers on its
# socket while it runs, and Quickshell otherwise.
set -u
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

if [ "$("$here/scripts/runtime")" = genoma ] \
        && [ -S "${XDG_RUNTIME_DIR:-/tmp}/genoma/${GENOMA_IPC:-bioma}.sock" ]; then
    exec "$here/scripts/genoma" ipc "$@"
fi
exec qs -p "$here/shell.qml" ipc call "$@"
