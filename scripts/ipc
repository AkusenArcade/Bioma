#!/usr/bin/env bash
# One way into the running Bioma.
#
#     ipc <target> <function> [argument…]      e.g.  ipc cell toggle vitals
#
# The targets and functions are genoma/ipc.luau's. Keybinds, `scripts/key`
# and the settings' Keybinds page call this, so a key does not depend on how
# the runtime is reached.
set -u
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
exec "$here/scripts/genoma" ipc "$@"
