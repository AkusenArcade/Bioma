#!/usr/bin/env python3
# Put text into the focused window, for Bioma's dictation.
#
#     paste        then one JSON object per line on stdin:
#                  {"text": "...", "terminal": false, "copyOnly": false}
#
# Prints `ready` once the keyboard exists, or `no-uinput` if it cannot, then
# `pasted` or `copied` for each text: pasted into the window, or only left on
# the clipboard because there is no keyboard to paste with.
#
# Why not type it: `wtype` uploads a keymap of its own and sends keycodes, and
# Electron never applies that keymap, so accented text arrives as
# `1234567890-=qwe…` in Teams, Obsidian and VS Code (tested on niri,
# 2026-09-29). A real Ctrl+V from a uinput keyboard goes through the user's
# own keymap and works everywhere. Terminals take Ctrl+Shift+V.
#
# The keyboard is made when the script starts, not when the text arrives:
# niri takes a moment to adopt a new input device, and dictation starts this
# script when it starts listening, so that moment is spent while the user
# speaks.
#
# The clipboard the user had is put back once the window has read the text.

import json
import subprocess
import sys
import time

# How long a new device takes to be followed, measured on niri; a paste
# before it is a paste into nothing.
ADOPTION = 1.5
# How long the window is given to read the clipboard before it is restored.
READ = 0.5

try:
    import evdev
    from evdev import ecodes as e
    keyboard = evdev.UInput(
        {e.EV_KEY: [e.KEY_LEFTCTRL, e.KEY_LEFTSHIFT, e.KEY_V]},
        name="bioma-paste")
    born = time.monotonic()
    print("ready", flush=True)
except Exception:
    keyboard = None
    print("no-uinput", flush=True)


def run(args):
    return subprocess.run(args, capture_output=True, timeout=5)


# wl-copy forks a child that stays to serve the selection. Left holding a
# pipe of ours, it keeps the pipe open and `run` waits out its timeout.
def copy(content, kind):
    subprocess.run(["wl-copy", "--type", kind], input=content,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)


def saved_clipboard():
    """The current selection as (type, bytes), or None if there is none."""
    listed = run(["wl-paste", "--list-types"])
    types = listed.stdout.decode(errors="replace").split() if listed.returncode == 0 else []
    if not types:
        return None
    chosen = next((t for t in types if t == "text/plain;charset=utf-8"), types[0])
    content = run(["wl-paste", "--no-newline", "--type", chosen])
    return (chosen, content.stdout) if content.returncode == 0 else None


def holds(text):
    now = run(["wl-paste", "--no-newline", "--type", "text/plain;charset=utf-8"])
    return now.returncode == 0 and now.stdout.decode(errors="replace") == text


def press(terminal):
    def key(code, value):
        keyboard.write(e.EV_KEY, code, value)
        keyboard.syn()
        time.sleep(0.02)

    key(e.KEY_LEFTCTRL, 1)
    if terminal:
        key(e.KEY_LEFTSHIFT, 1)
    key(e.KEY_V, 1)
    key(e.KEY_V, 0)
    if terminal:
        key(e.KEY_LEFTSHIFT, 0)
    key(e.KEY_LEFTCTRL, 0)


for line in sys.stdin:
    try:
        request = json.loads(line)
    except json.JSONDecodeError:
        continue
    text = request.get("text", "")
    if not text:
        continue

    # With no window to paste into, the text is left on the clipboard: pasting
    # into nothing and then restoring would lose it.
    only_copy = keyboard is None or request.get("copyOnly")

    before = None if only_copy else saved_clipboard()
    copy(text.encode(), "text/plain;charset=utf-8")

    if only_copy:
        print("copied", flush=True)
        continue

    # wl-copy returns once it has forked; the selection is usually taken by
    # then, but a paste that reads the previous clipboard is the one failure
    # that looks like success, so it is checked.
    for _ in range(20):
        if holds(text):
            break
        time.sleep(0.05)

    wait = ADOPTION - (time.monotonic() - born)
    if wait > 0:
        time.sleep(wait)

    press(bool(request.get("terminal")))
    time.sleep(READ)

    if before is not None:
        copy(before[1], before[0])
    print("pasted", flush=True)
