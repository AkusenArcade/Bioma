#!/usr/bin/env bash
# Which shell runs this session, and how to change your mind.
#
# There is one of several things a desktop shell owns that only one program
# may own at a time — `org.freedesktop.Notifications` is the loud one — so
# running two is not a thing to do, and going back to the other one is a thing
# to do often while this one is still being built.
#
#     shell                 what is running, and what will run at login
#     shell bioma           stop the other, start Bioma, remember it
#     shell noctalia        stop Bioma, start Noctalia, remember it
#     shell toggle          the other one from whatever is running now
#     shell start           start whichever is remembered — this is the line
#                           niri spawns at login
#
# The choice is remembered in ~/.config/bioma/shell, outside the repository,
# because it is a fact about this machine's session and not about the project.
set -eu

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
state_dir="${XDG_CONFIG_HOME:-$HOME/.config}/bioma"
state="$state_dir/shell"

bioma_pattern="qs -p $here/shell.qml"

# Every live process running Bioma's shell. Quickshell's own list is asked
# first, by config path, because it is the only thing that knows an instance
# its crash handler relaunched: that one runs as a bare `/usr/bin/quickshell`,
# with no arguments for a pattern to find. The lock screen and the greeter run
# other files and are never among them.
bioma_pids() {
    {
        qs list --all 2>/dev/null | awk -v want="$here/shell.qml" '
            /^Instance/     { pid = "" }
            /Process ID:/   { pid = $3 }
            /Config path:/  { sub(/^[ \t]*Config path:[ \t]*/, ""); if ($0 == want && pid != "") print pid }'
        pgrep -f -- "$bioma_pattern" 2>/dev/null || true
    } | sort -u | while read -r pid; do
        stat="$(ps -o stat= -p "$pid" 2>/dev/null | cut -c1)"
        if [ -n "$stat" ] && [ "$stat" != Z ]; then echo "$pid"; fi
    done
}

bioma_running() { [ -n "$(bioma_pids)" ]; }
noctalia_running() { pgrep -x noctalia >/dev/null 2>&1; }

# Asked to stop, Bioma sometimes crashes on its way out — a Qt Repeater torn
# down in the wrong order — and Quickshell's crash handler starts it again a
# moment later. So stopping is not over when the process exits; it is over
# when nothing of Bioma has come back for a second and a half. Whatever does
# come back is killed outright: a relaunch has nothing to save, and no second
# teardown to crash in. Without this, the other shell started beside a Bioma
# nobody could see was there.
stop_bioma() {
    local first pids pid quiet=0
    first="$(bioma_pids)"
    [ -n "$first" ] || return 0
    # shellcheck disable=SC2086
    kill -TERM $first 2>/dev/null || true
    for _ in $(seq 1 60); do
        sleep 0.1
        pids="$(bioma_pids)"
        if [ -z "$pids" ]; then
            quiet=$((quiet + 1))
            # The bus name is handed over on exit, and the next shell
            # registers on the release — so the wait is the handover.
            [ "$quiet" -ge 15 ] && return 0
            continue
        fi
        quiet=0
        for pid in $pids; do
            case " $(echo $first) " in
                *" $pid "*) ;;                          # still leaving
                *) kill -KILL "$pid" 2>/dev/null || true ;;  # came back
            esac
        done
    done
    # Past six seconds whatever is left is not leaving by itself.
    pids="$(bioma_pids)"
    # shellcheck disable=SC2086
    [ -z "$pids" ] || kill -KILL $pids 2>/dev/null || true
}

stop_noctalia() {
    noctalia_running || return 0
    pkill -x noctalia || true
    for _ in $(seq 1 40); do
        noctalia_running || return 0
        sleep 0.1
    done
}

start_bioma() {
    bioma_running && return 0
    setsid "$here/scripts/bioma" >/dev/null 2>&1 < /dev/null &
    disown || true
}

start_noctalia() {
    noctalia_running && return 0
    setsid noctalia -d >/dev/null 2>&1 < /dev/null &
    disown || true
}

remember() {
    mkdir -p "$state_dir"
    printf '%s\n' "$1" > "$state"
}

remembered() {
    [ -r "$state" ] && cat "$state" || printf 'bioma\n'
}

# Noctalia appends `include "noctalia.kdl"` to niri's config every time it
# starts. Last in the file, its colours win over Bioma's bioma-theme.kdl, and
# after one round trip the focus ring stayed Noctalia's teal under Bioma
# (Akusen, 2026-09-28). Coming back to Bioma takes the line out again; niri
# reloads by itself, and Noctalia puts it back when it is chosen.
drop_noctalia_theme() {
    local config="${NIRI_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/niri/config.kdl}"
    [ -f "$config" ] || return 0
    grep -q '^[[:space:]]*include[[:space:]]\+"noctalia\.kdl"[[:space:]]*$' "$config" || return 0
    sed -i '/^[[:space:]]*include[[:space:]]\+"noctalia\.kdl"[[:space:]]*$/d' "$config"
}

to_bioma() {
    stop_noctalia
    drop_noctalia_theme
    start_bioma
    remember bioma
    echo "bioma"
}

to_noctalia() {
    stop_bioma
    start_noctalia
    remember noctalia
    echo "noctalia"
}

case "${1-status}" in
    bioma)    to_bioma ;;
    noctalia) to_noctalia ;;
    toggle)
        if bioma_running; then to_noctalia; else to_bioma; fi
        ;;
    start)
        case "$(remembered)" in
            noctalia) start_noctalia ;;
            *)        drop_noctalia_theme; start_bioma ;;
        esac
        ;;
    status|"")
        running="none"
        bioma_running && running="bioma"
        noctalia_running && running="${running/none/}noctalia"
        echo "running:    ${running:-none}"
        echo "at login:   $(remembered)"
        ;;
    *)
        echo "usage: shell [bioma|noctalia|toggle|start|status]" >&2
        exit 2
        ;;
esac
