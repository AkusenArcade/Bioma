#!/bin/sh
# What greetd runs, as the `greeter` user: a minimal niri holding Bioma's
# greeter, which ends when the greeter has handed over to the session.
#
#     [default_session]
#     command = "/usr/share/bioma/scripts/greeter-session"
#     user = "greeter"
#
# It runs the copy scripts/greeter-sync keeps, and points the greeter's
# configuration, data and fonts there, so the greeter reads the user's own
# appearance through the ordinary paths. Run from inside the copy — this file
# is part of it — it runs that copy; run from anywhere else, such as the
# package, it runs the one in $BIOMA_GREETER_DIR, or /var/lib/bioma-greeter.
#
# With no copy to run there is no Bioma greeter yet, and greetd's plain one,
# agreety, asks for the password instead: a login screen must never be empty.
#
# The log goes to /tmp/bioma-greeter.log, because a greeter that does not come
# up has nowhere else to say why.
set -eu

live="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
if [ ! -f "$live/niri.kdl" ]; then
    live="${BIOMA_GREETER_DIR:-/var/lib/bioma-greeter}/live"
fi

if [ ! -f "$live/niri.kdl" ] || ! command -v niri >/dev/null 2>&1 \
        || ! command -v qs >/dev/null 2>&1; then
    echo "=== bioma greeter $(date -Iseconds): no copy at $live, agreety instead ===" \
        >>/tmp/bioma-greeter.log 2>&1 || true
    exec agreety --cmd niri-session
fi

export BIOMA_GREETER_DIR="$live"
export XDG_CONFIG_HOME="$live/config"
export XDG_DATA_HOME="$live/data"
export XDG_CACHE_HOME="/tmp/bioma-greeter-cache-$(id -u)"
export XDG_STATE_HOME="/tmp/bioma-greeter-state-$(id -u)"

# greetd's PAM session may not give the greeter a runtime directory.
if [ -z "${XDG_RUNTIME_DIR:-}" ] || [ ! -w "${XDG_RUNTIME_DIR:-/nonexistent}" ]; then
    XDG_RUNTIME_DIR="/tmp/bioma-greeter-runtime-$(id -u)"
    export XDG_RUNTIME_DIR
fi
mkdir -p "$XDG_RUNTIME_DIR" "$XDG_CACHE_HOME" "$XDG_STATE_HOME"
chmod 700 "$XDG_RUNTIME_DIR"
unset WAYLAND_DISPLAY

exec >>/tmp/bioma-greeter.log 2>&1
echo "=== bioma greeter $(date -Iseconds) from $live ==="

if command -v dbus-run-session >/dev/null 2>&1; then
    exec dbus-run-session -- niri -c "$live/niri.kdl"
fi
exec niri -c "$live/niri.kdl"
