#!/usr/bin/env bash
# Set Bioma up for this user, from wherever the repository is.
#
#     scripts/install              check what is missing, write the keys, and
#                                  include Bioma's niri files
#     scripts/install --autostart  also start Bioma with the niri session
#     scripts/install --force      write the keys again over an existing copy
#     scripts/install --check      only say what is missing
#
# What it writes, all of it next to niri's config.kdl:
#   - bioma-binds.kdl, from config/niri/bioma-binds.kdl.in with the repository's
#     path filled in. Only if there is none yet: the copy is the user's, and the
#     settings cell's Keybinds page edits it in place.
#   - `include` lines at the end of config.kdl for the repository's
#     config/niri/bioma.kdl and for bioma-binds.kdl — once each. An include of
#     the repository's own binds file, from before the template, is replaced.
#   - with --autostart, `spawn-at-startup ".../scripts/shell" "start"`.
#
# config.kdl is copied aside first and the whole configuration is handed to
# `niri validate` afterwards; if niri refuses it, the copy is put back.
set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

autostart=false
force=false
check_only=false
for arg in "$@"; do
    case "$arg" in
        --autostart) autostart=true ;;
        --force) force=true ;;
        --check) check_only=true ;;
        -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "unknown option: $arg" >&2; exit 2 ;;
    esac
done

# ---- What is missing ---------------------------------------------------------
#
# Required is everything the package depends on: without it a cell is empty or
# a key does nothing. Only dictation and the company network wizard are
# optional, and their absence costs only that.

missing_required=0

need() {   # program, Arch package, what for
    if command -v "$1" >/dev/null 2>&1; then
        printf '  ok        %-16s %s\n' "$1" "$3"
    else
        printf '  MISSING   %-16s %s  (%s)\n' "$1" "$3" "$2"
        missing_required=$((missing_required + 1))
    fi
}

need_part() {   # present?, name, what for, Arch package
    if [ "$1" = yes ]; then
        printf '  ok        %-16s %s\n' "$2" "$3"
    else
        printf '  MISSING   %-16s %s  (%s)\n' "$2" "$3" "$4"
        missing_required=$((missing_required + 1))
    fi
}

want_part() {   # present?, name, what for, Arch package
    if [ "$1" = yes ]; then
        printf '  ok        %-16s %s\n' "$2" "$3"
    else
        printf '  optional  %-16s %s  (%s)\n' "$2" "$3" "$4"
    fi
}

has() { command -v "$1" >/dev/null 2>&1 && echo yes; }
# Not `grep -q`: it stops at the first match, fc-list dies of the closed pipe,
# and under pipefail a font that is there reads as missing.
font() { fc-list : family 2>/dev/null | grep -i "$1" >/dev/null && echo yes; }

echo "Required:"
need niri       niri            "the compositor, 26.04 or later"
need qs         quickshell      "the shell runtime, 0.3.1"
need python3    python          "the helper scripts"
need gsettings  glib2           "desktop settings: theme, icons, cursor, proxy"
need wl-paste   wl-clipboard    "the clipboard cell"
need magick     imagemagick     "wallpaper thumbnails"
# A QML module rather than a program: Quickshell does not bring it, and the
# cells that mask a picture through it do not load without it.
need_part "$([ -d /usr/lib/qt6/qml/Qt5Compat/GraphicalEffects ] && echo yes)" \
    "Qt5Compat" "picture masks (QML module)" "qt6-5compat"
need fc-list    fontconfig      "the fonts"
need_part "$(font Spectral)" "Spectral" "the expressive voice" "AUR ttf-spectral"
need_part "$(font Orbitron)" "Orbitron" "the technical voice" "AUR ttf-orbitron"
need matugen    matugen         "palettes computed from the wallpaper"
need zenity     zenity          "the wallpaper folder picker"
need grim       grim            "screenshots"
need tesseract  tesseract       "text recognition from a region"
need_part "$(tesseract --list-langs 2>/dev/null | grep -qx eng && echo yes)" \
    "tessdata eng" "text recognition, in English" "tesseract-data-eng"
need wl-screenrec wl-screenrec  "screen recording (AUR)"
need pw-play    pipewire-audio  "the alarm's sound, the microphone"
need nmcli      networkmanager  "Wi-Fi, wired, VPN and proxy triggers"
need bluetoothctl bluez-utils   "Bluetooth pairing"
need_part "$([ -x /usr/lib/bluetooth/bluetoothd ] && echo yes)" \
    "bluetoothd" "Bluetooth" "bluez"
need lpstat     cups            "printers"
need avahi-browse avahi         "network printers, found and added driverless"
need brightnessctl brightnessctl "the backlight, on a laptop"
need ddcutil    ddcutil         "external monitor brightness"
need upower     upower          "the battery, on a laptop"
need powerprofilesctl power-profiles-daemon "the power profile (or tuned-ppd)"
need lspci      pciutils        "the graphics card, in the System cell"
need notify-send libnotify      "the timer and alarm notifications"
need_part "$([ -x /usr/lib/xdg-desktop-portal-gtk ] && echo yes)" \
    "portal gtk" "notifications from Flatpaks, the avatar's file picker" "xdg-desktop-portal-gtk"
need hyprlock   hyprlock        "the lock screen's fallback"
need greetd     greetd          "the Bioma greeter"

echo "Optional:"
# Dictation's parts. The package leaves them optional: the model alone is
# half a gigabyte, for one button.
model=/usr/share/whisper.cpp-model-large-v3-turbo-q5_0/ggml-large-v3-turbo-q5_0.bin
want_part "$(has whisper-cli)" "whisper-cli" "dictation: the engine" "whisper-cpp"
want_part "$([ -r "$model" ] && echo yes)" "model" "dictation: large-v3-turbo q5_0" \
    "AUR whisper.cpp-model-large-v3-turbo-q5_0"
want_part "$(ls /usr/lib/ggml/libggml-vulkan*.so >/dev/null 2>&1 && echo yes)" "ggml-vulkan" \
    "dictation on the GPU; without it, the CPU" "ggml-vulkan"
want_part "$(python3 -c 'import evdev' 2>/dev/null && echo yes)" "python-evdev" \
    "dictation: pasting into the window" "python-evdev"
want_part "$([ -w /dev/uinput ] && echo yes)" "/dev/uinput" \
    "dictation: pasting; without it the text stays on the clipboard" \
    "packaging/system/70-bioma-uinput.rules into /etc/udev/rules.d"
want_part "$(has bnw)" "network wizard" \
    "company network setup, from the connectivity cell" "AUR business-network-wizard"

if command -v niri >/dev/null 2>&1; then
    version="$(niri --version 2>/dev/null | awk '{print $2}')"
    major="${version%%.*}"
    if [ -n "$major" ] && [ "$major" -lt 26 ] 2>/dev/null; then
        echo "  niri $version is older than 26.04: blur (ext-background-effect) will not work." >&2
    fi
fi

# ---- System services ---------------------------------------------------------
#
# A package does not enable services, and this script does not run sudo: a
# machine that keeps its network with iwd or systemd-networkd would lose it to
# NetworkManager. So the disabled ones are named, with the one command that
# enables them.

disabled=()
service() {   # unit(s), any one enabled is enough; the first is the one named
    local unit
    for unit in "$@"; do
        case "$(systemctl is-enabled "$unit" 2>/dev/null)" in
            enabled|enabled-runtime|static|indirect|alias) return ;;
        esac
    done
    # A unit that is not installed was reported above, as a program.
    if systemctl cat "$1" >/dev/null 2>&1; then disabled+=("$1"); fi
}
service NetworkManager.service
service bluetooth.service
service cups.socket cups.service
service avahi-daemon.service avahi-daemon.socket
# power-profiles-daemon and tuned-ppd are started by D-Bus when first asked.

if [ "${#disabled[@]}" -gt 0 ]; then
    echo "Services not enabled — the cells that read them stay empty until they are:"
    printf '  %s\n' "${disabled[@]}"
    echo "  sudo systemctl enable --now ${disabled[*]}"
fi

if [ "$missing_required" -gt 0 ]; then
    echo
    echo "$missing_required required program(s) missing; install them and run this again." >&2
    exit 1
fi
$check_only && exit 0

# ---- niri ------------------------------------------------------------------------

config="${NIRI_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/niri/config.kdl}"
if [ ! -f "$config" ]; then
    echo "No niri configuration at $config — start niri once, or set NIRI_CONFIG." >&2
    exit 1
fi
real="$(readlink -f "$config")"
dir="$(dirname "$real")"
binds="$dir/bioma-binds.kdl"

backup="$real.before-bioma.$(date +%Y%m%d-%H%M%S)"
cp -p "$real" "$backup"

if [ ! -f "$binds" ] || $force; then
    sed "s#@BIOMA@#$here#g" "$here/config/niri/bioma-binds.kdl.in" >"$binds"
    echo "wrote     $binds"
else
    echo "kept      $binds (yours; --force writes it again)"
    # Yours, but it may name another Bioma: the clone before a package, or a
    # repository that moved. Its keys stay; only the path in them changes.
    moved="$(python3 - "$binds" "$here" <<'PY'
import re, sys
path, here = sys.argv[1], sys.argv[2]
text = open(path).read()
roots = set(re.findall(r'"([^"]+)/shell\.qml"', text)) | set(re.findall(r'"([^"]+)/scripts/[a-z-]+"', text))
roots.discard(here)
for root in roots:
    text = text.replace(f'"{root}/', f'"{here}/')
if roots:
    open(path, "w").write(text)
print(" ".join(sorted(roots)))
PY
)"
    [ -n "$moved" ] && echo "pointed   $binds from $moved to $here"
fi

# An include of the repository's own binds file predates the template: it is
# the same keys, read from the repository, so it becomes the written copy.
old="include \"$here/config/niri/bioma-binds.kdl\""
if grep -qF "$old" "$real"; then
    sed -i "s#^\([[:space:]]*\)include \"$here/config/niri/bioma-binds.kdl\"#\1include \"bioma-binds.kdl\"#" "$real"
    echo "replaced  the include of $here/config/niri/bioma-binds.kdl"
fi

ensure() {   # a line, and a pattern that finds it already there
    if ! grep -qE "$2" "$real"; then
        printf '\n%s\n' "$1" >>"$real"
        echo "added     $1"
        return
    fi
    # There, but pointing somewhere else: a clone the package has replaced,
    # or a repository that moved. Left alone, niri would go on reading the old
    # copy, and the login would start it. The line is rewritten in place.
    if ! grep -qxF "$1" <(sed 's/^[[:space:]]*//; s/[[:space:]]*$//' "$real"); then
        python3 - "$real" "$2" "$1" <<'PY'
import re, sys
path, pattern, line = sys.argv[1], sys.argv[2].replace("[[:space:]]", r"\s"), sys.argv[3]
text = open(path).read().split("\n")
out = [(re.match(r"\s*", l).group(0) + line) if re.search(pattern, l) else l for l in text]
open(path, "w").write("\n".join(out))
PY
        echo "pointed   $1"
    fi
}

ensure "include \"$here/config/niri/bioma.kdl\"" \
       "^[[:space:]]*include[[:space:]]+\"[^\"]*/config/niri/bioma\.kdl\""
ensure "include \"bioma-binds.kdl\"" \
       "^[[:space:]]*include[[:space:]]+\"(.*/)?bioma-binds\.kdl\""
if $autostart; then
    ensure "spawn-at-startup \"$here/scripts/shell\" \"start\"" \
           "^[[:space:]]*spawn-at-startup[[:space:]]+\"[^\"]*/scripts/shell\"[[:space:]]+\"start\""
fi

if refusal="$(niri validate -c "$config" 2>&1)"; then
    if cmp -s "$backup" "$real"; then
        rm -f "$backup"
    else
        echo "config.kdl was changed; the previous one is $backup"
    fi
    echo "niri accepts the configuration."
else
    cp -p "$backup" "$real"
    echo "niri refused the result, so config.kdl is back as it was:" >&2
    printf '%s\n' "$refusal" | sed 's/\x1b\[[0-9;]*m//g' | tail -5 >&2
    exit 1
fi

echo
echo "Start Bioma with $here/scripts/shell bioma — or log in again, with --autostart."
