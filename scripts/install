#!/usr/bin/env bash
# Set Bioma up for this user, from wherever the repository is.
#
#     scripts/install              check what is missing, write the keys, and
#                                  include Bioma's files in the compositor's
#                                  configuration
#     scripts/install --autostart  also start Bioma with the session
#     scripts/install --force      write the keys again over an existing copy
#     scripts/install --check      only say what is missing
#     scripts/install --report     what --check says, and what is already in
#                                  the compositor's configuration, one fact per
#                                  line in tab-separated fields — for the setup
#     scripts/install --files-only write the keys and the includes without
#                                  checking for programs first — for the setup,
#                                  which says what is missing on a page of its
#                                  own (--niri-only, its old name, still works)
#     scripts/install --compositor niri|hyprland|umbriel
#                                  set Bioma up for that one. Without it: the
#                                  one running, else the only one installed,
#                                  else niri.
#
# Hyprland (0.57 or later: its configuration is Lua) gets bioma-rules.lua and
# bioma-binds.lua beside hyprland.lua, required at its end
# (scripts/hypr-include), and with --autostart bioma-autostart.lua. Umbriel
# gets bioma-binds.toml, included from config.toml (scripts/umbriel-include,
# which takes the same keys out of config.toml, since config.toml would win),
# and with --autostart Bioma in config.toml's `general.autostart`; without a
# config.toml, Umbriel's packaged one is copied there first. Either way the
# configuration is copied aside first and checked whole afterwards
# (`Hyprland --verify-config`, `umbriel config validate`), and put back if the
# compositor refuses it.
#
# On niri, what it writes, all of it next to niri's config.kdl:
#   - bioma-binds.kdl, from config/niri/bioma-binds.kdl.in with the repository's
#     path filled in. Only if there is none yet: the copy is the user's, and the
#     settings cell's Keybinds page edits it in place. A copy already there gets
#     the template's keys it has never been offered (scripts/binds).
#   - `include` lines at the end of config.kdl for the repository's
#     config/niri/bioma.kdl and for bioma-binds.kdl — once each. An include of
#     the repository's own binds file, from before the template, is replaced.
#   - with --autostart, `spawn-at-startup ".../scripts/shell" "start"`.
#
# config.kdl is copied aside first and the whole configuration is handed to
# `niri validate` afterwards; if niri refuses it, the copy is put back.
set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

autostart=false
force=false
check_only=false
report=false
niri_only=false
compositor=""
while [ $# -gt 0 ]; do
    case "$1" in
        --autostart) autostart=true ;;
        --force) force=true ;;
        --check) check_only=true ;;
        --report) report=true; check_only=true ;;
        --files-only|--niri-only) niri_only=true ;;
        --compositor) shift; compositor="${1:-}" ;;
        --compositor=*) compositor="${1#--compositor=}" ;;
        -h|--help) sed -n '2,46p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "unknown option: $1" >&2; exit 2 ;;
    esac
    shift
done

# The compositor: the one this runs under, else the only one installed.
running_umbriel() {
    [ -n "${UMBRIEL_SOCKET:-}" ] && return 0
    [ -n "${WAYLAND_DISPLAY:-}" ] && [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/umbriel-$WAYLAND_DISPLAY.sock" ]
}
if [ -z "$compositor" ]; then
    if [ -n "${NIRI_SOCKET:-}" ]; then compositor=niri
    elif [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then compositor=hyprland
    elif running_umbriel; then compositor=umbriel
    else
        installed=()
        command -v niri >/dev/null 2>&1 && installed+=(niri)
        command -v Hyprland >/dev/null 2>&1 && installed+=(hyprland)
        command -v umbriel >/dev/null 2>&1 && installed+=(umbriel)
        compositor="${installed[0]:-niri}"
        [ "${#installed[@]}" -gt 1 ] && compositor=niri
    fi
fi
case "$compositor" in
    niri|hyprland|umbriel) ;;
    *) echo "unknown compositor: $compositor (niri, hyprland or umbriel)" >&2; exit 2 ;;
esac

# ---- What is missing ---------------------------------------------------------
#
# Required is everything the package depends on: without it a cell is empty or
# a key does nothing. Only dictation and the company network wizard are
# optional, and their absence costs only that.

missing_required=0

# With --report, each check is one line: `required` or `optional`, `ok` or
# `missing`, the name, what it is for, and the package.
fact() {   # kind, present?, name, what for, package
    printf '%s\t%s\t%s\t%s\t%s\n' "$1" "$([ "$2" = yes ] && echo ok || echo missing)" "$3" "$4" "$5"
}

need() {   # program, Arch package, what for
    if $report; then
        fact required "$(command -v "$1" >/dev/null 2>&1 && echo yes)" "$1" "$3" "$2"
        command -v "$1" >/dev/null 2>&1 || missing_required=$((missing_required + 1))
        return
    fi
    if command -v "$1" >/dev/null 2>&1; then
        printf '  ok        %-16s %s\n' "$1" "$3"
    else
        printf '  MISSING   %-16s %s  (%s)\n' "$1" "$3" "$2"
        missing_required=$((missing_required + 1))
    fi
}

need_part() {   # present?, name, what for, Arch package
    if $report; then
        fact required "$1" "$2" "$3" "$4"
        [ "$1" = yes ] || missing_required=$((missing_required + 1))
        return
    fi
    if [ "$1" = yes ]; then
        printf '  ok        %-16s %s\n' "$2" "$3"
    else
        printf '  MISSING   %-16s %s  (%s)\n' "$2" "$3" "$4"
        missing_required=$((missing_required + 1))
    fi
}

want_part() {   # present?, name, what for, Arch package
    if $report; then
        fact optional "$1" "$2" "$3" "$4"
        return
    fi
    if [ "$1" = yes ]; then
        printf '  ok        %-16s %s\n' "$2" "$3"
    else
        printf '  optional  %-16s %s  (%s)\n' "$2" "$3" "$4"
    fi
}

has() { command -v "$1" >/dev/null 2>&1 && echo yes; }
# Not `grep -q`: it stops at the first match, fc-list dies of the closed pipe,
# and under pipefail a font that is there reads as missing.
font() { fc-list : family 2>/dev/null | grep -i "$1" >/dev/null && echo yes; }

# Writing the niri files only, the checks run unheard: the setup has asked
# for them already, and says what is missing on a page of its own.
if $niri_only; then exec 3>&1 1>/dev/null; fi

$report || echo "Required:"
case "$compositor" in
    niri) need niri niri "the compositor, 26.04 or later" ;;
    hyprland) need Hyprland hyprland "the compositor, 0.57 or later" ;;
    umbriel) need umbriel umbriel "the compositor" ;;
esac
need genoma     genoma          "the shell runtime"
need python3    python          "the helper scripts"
need gsettings  glib2           "desktop settings: theme, icons, cursor, proxy"
need wl-paste   wl-clipboard    "the clipboard cell"
need magick     imagemagick     "wallpaper thumbnails"
need fc-list    fontconfig      "the fonts"
need_part "$(font Spectral)" "Spectral" "the expressive voice" "AUR ttf-spectral"
need_part "$(font Orbitron)" "Orbitron" "the technical voice" "AUR ttf-orbitron"
need matugen    matugen         "palettes computed from the wallpaper"
need zenity     zenity          "the wallpaper folder picker"
need fd         fd              "files found by name in the launcher"
need qalc       libqalculate    "sums and conversions in the launcher"
need udisksctl  udisks2         "removable drives, opened and ejected"
need xdg-open   xdg-utils       "files and folders opened with their default application"
need curl       curl            "the weather organism's forecast"
need grim       grim            "screenshots"
need tesseract  tesseract       "text recognition from a region"
need_part "$(tesseract --list-langs 2>/dev/null | grep -qx eng && echo yes)" \
    "tessdata eng" "text recognition, in English" "tesseract-data-eng"
need pw-play    pipewire-audio  "the alarm's sound, the microphone"
need nmcli      networkmanager  "Wi-Fi, wired, VPN and proxy triggers"
need bluetoothctl bluez-utils   "Bluetooth pairing"
need_part "$([ -x /usr/lib/bluetooth/bluetoothd ] && echo yes)" \
    "bluetoothd" "Bluetooth" "bluez"
need lpstat     cups            "printers"
need avahi-browse avahi         "network printers, found and added driverless"
need brightnessctl brightnessctl "the backlight, on a laptop"
need ddcutil    ddcutil         "external monitor brightness"
need upower     upower          "the battery, on a laptop"
need powerprofilesctl power-profiles-daemon "the power profile (or tuned-ppd)"
need lspci      pciutils        "the graphics card, in the System cell"
need notify-send libnotify      "the timer and alarm notifications"
need_part "$([ -x /usr/lib/xdg-desktop-portal-gtk ] && echo yes)" \
    "portal gtk" "notifications from Flatpaks, the avatar's file picker" "xdg-desktop-portal-gtk"
need hyprlock   hyprlock        "the lock screen's fallback"
need greetd     greetd          "the Bioma greeter"
need agreety    greetd-agreety  "the plain greeter, while the Bioma one has no copy to run"

$report || echo "Optional:"
# Dictation's parts. The package leaves them optional: the model alone is
# half a gigabyte, for one button.
model=/usr/share/whisper.cpp-model-large-v3-turbo-q5_0/ggml-large-v3-turbo-q5_0.bin
want_part "$(has whisper-cli)" "whisper-cli" "dictation: the engine" "whisper-cpp"
want_part "$([ -r "$model" ] && echo yes)" "model" "dictation: large-v3-turbo q5_0" \
    "AUR whisper.cpp-model-large-v3-turbo-q5_0"
want_part "$(ls /usr/lib/ggml/libggml-vulkan*.so >/dev/null 2>&1 && echo yes)" "ggml-vulkan" \
    "dictation on the GPU; without it, the CPU" "ggml-vulkan"
want_part "$(python3 -c 'import evdev' 2>/dev/null && echo yes)" "python-evdev" \
    "dictation: pasting into the window" "python-evdev"
want_part "$([ -w /dev/uinput ] && echo yes)" "/dev/uinput" \
    "dictation: pasting; without it the text stays on the clipboard" \
    "packaging/system/70-bioma-uinput.rules into /etc/udev/rules.d"
want_part "$(has wl-screenrec)" "wl-screenrec" \
    "screen recording in the capture cell" "AUR wl-screenrec"
want_part "$(has bnw)" "network wizard" \
    "company network setup, from the connectivity cell" "AUR business-network-wizard"

if ! $report && [ "$compositor" = niri ] && command -v niri >/dev/null 2>&1; then
    version="$(niri --version 2>/dev/null | awk '{print $2}')"
    major="${version%%.*}"
    if [ -n "$major" ] && [ "$major" -lt 26 ] 2>/dev/null; then
        echo "  niri $version is older than 26.04: blur (ext-background-effect) will not work." >&2
    fi
fi

# What is already in the compositor's configuration, for --report: which
# compositor, its configuration file, the keys file, the includes, the line
# that starts Bioma with the session, and whether anything can ask for a
# password — the setup's compositor and LOGIN steps read these rather than
# guessing.
report_niri() {
    local config real dir
    printf 'compositor\tname\t%s\n' "$compositor"
    case "$compositor" in
        niri) config="${NIRI_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/niri/config.kdl}" ;;
        hyprland) config="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.lua" ;;
        umbriel) config="${XDG_CONFIG_HOME:-$HOME/.config}/umbriel/config.toml" ;;
    esac
    if [ ! -f "$config" ]; then
        printf 'compositor\tconfig\tmissing\n'
    else
        real="$(readlink -f "$config")"
        dir="$(dirname "$real")"
        printf 'compositor\tconfig\tok\t%s\n' "$real"
        found() { grep -qE "$1" "$real" && echo ok || echo missing; }
        case "$compositor" in
            niri)
                printf 'compositor\tbinds\t%s\n' "$([ -f "$dir/bioma-binds.kdl" ] && echo ok || echo missing)"
                printf 'compositor\tinclude\t%s\n' \
                    "$(found '^[[:space:]]*include[[:space:]]+"[^"]*/config/niri/bioma\.kdl"')"
                printf 'compositor\tinclude-binds\t%s\n' \
                    "$(found '^[[:space:]]*include[[:space:]]+"(.*/)?bioma-binds\.kdl"')"
                printf 'compositor\tautostart\t%s\n' \
                    "$(found '^[[:space:]]*spawn-at-startup[[:space:]]+"[^"]*/scripts/shell"[[:space:]]+"start"')"
                ;;
            hyprland)
                printf 'compositor\tbinds\t%s\n' "$([ -f "$dir/bioma-binds.lua" ] && echo ok || echo missing)"
                printf 'compositor\tinclude\t%s\n' "$(found '^[[:space:]]*require[[:space:]]*\(?[[:space:]]*["'"'"']bioma-rules["'"'"']')"
                printf 'compositor\tinclude-binds\t%s\n' "$(found '^[[:space:]]*require[[:space:]]*\(?[[:space:]]*["'"'"']bioma-binds["'"'"']')"
                printf 'compositor\tautostart\t%s\n' "$(found '^[[:space:]]*require[[:space:]]*\(?[[:space:]]*["'"'"']bioma-autostart["'"'"']')"
                ;;
            umbriel)
                printf 'compositor\tbinds\t%s\n' "$([ -f "$dir/bioma-binds.toml" ] && echo ok || echo missing)"
                # Umbriel needs no rules of Bioma's from the repository: its
                # glass is written by the shell.
                printf 'compositor\tinclude\tok\n'
                printf 'compositor\tinclude-binds\t%s\n' "$(found '["'"'"']bioma-binds\.toml["'"'"']')"
                printf 'compositor\tautostart\t%s\n' "$(found "^[[:space:]]*autostart[[:space:]]*=.*/scripts/shell'?[[:space:]]+start")"
                ;;
        esac
    fi
    # An authentication agent is a process of the session; there is no bus
    # name to ask for. These are the ones a niri session is likely to run,
    # Quickshell configurations that hold one of their own included.
    if pgrep -f 'polkit.*agent|lxpolkit|hyprpolkitagent|soteria|xfce-polkit|polkit-mate|mate-polkit|polkit-kde|polkit-gnome' >/dev/null 2>&1; then
        printf 'polkit\tagent\tok\n'
    else
        printf 'polkit\tagent\tmissing\n'
    fi
}

# ---- System services ---------------------------------------------------------
#
# A package does not enable services, and this script does not run sudo: a
# machine that keeps its network with iwd or systemd-networkd would lose it to
# NetworkManager. So the disabled ones are named, with the one command that
# enables them.

disabled=()
service() {   # unit(s), any one enabled is enough; the first is the one named
    local unit
    for unit in "$@"; do
        case "$(systemctl is-enabled "$unit" 2>/dev/null)" in
            enabled|enabled-runtime|static|indirect|alias) return ;;
        esac
    done
    # A unit that is not installed was reported above, as a program.
    if systemctl cat "$1" >/dev/null 2>&1; then disabled+=("$1"); fi
}
service NetworkManager.service
service bluetooth.service
service cups.socket cups.service
service avahi-daemon.service avahi-daemon.socket
# power-profiles-daemon and tuned-ppd are started by D-Bus when first asked.

if $report; then
    for unit in "${disabled[@]}"; do printf 'service\tdisabled\t%s\n' "$unit"; done
    report_niri
    exit 0
fi

if [ "${#disabled[@]}" -gt 0 ]; then
    echo "Services not enabled — the cells that read them stay empty until they are:"
    printf '  %s\n' "${disabled[@]}"
    echo "  sudo systemctl enable --now ${disabled[*]}"
fi

if $niri_only; then exec 1>&3 3>&-; missing_required=0; fi

if [ "$missing_required" -gt 0 ]; then
    echo
    echo "$missing_required required program(s) missing; install them and run this again." >&2
    exit 1
fi
$check_only && exit 0

# ---- Hyprland and Umbriel ----------------------------------------------------------

# A copy of Bioma's keys that names another Bioma (the clone before a
# package, or a repository that moved) is pointed here; its keys stay.
repoint() {   # file
    python3 - "$1" "$here" <<'PY'
import re, sys
path, here = sys.argv[1], sys.argv[2]
text = open(path).read()
roots = set(re.findall(r"""['"]([^'"\s]+)/scripts/[a-z-]+""", text))
roots.discard(here)
for root in roots:
    text = text.replace(root + "/scripts/", here + "/scripts/")
if roots:
    open(path, "w").write(text)
print(" ".join(sorted(roots)))
PY
}

if [ "$compositor" = hyprland ]; then
    hdir="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
    config="$hdir/hyprland.lua"
    if [ ! -f "$config" ]; then
        echo "No Hyprland configuration at $config — start Hyprland once (0.57 writes hyprland.lua)." >&2
        exit 1
    fi
    real="$(readlink -f "$config")"
    backup="$real.before-bioma.$(date +%Y%m%d-%H%M%S)"
    cp -p "$real" "$backup"
    put_back() { cp -p "$backup" "$real"; echo "Hyprland refused it, so hyprland.lua is back as it was." >&2; exit 1; }
    "$here/scripts/hypr-include" rules <"$here/config/hyprland/bioma-rules.lua" || put_back
    binds="$hdir/bioma-binds.lua"
    if [ ! -f "$binds" ] || $force; then
        sed "s#@BIOMA@#$here#g" "$here/config/hyprland/bioma-binds.lua.in" | "$here/scripts/hypr-include" binds || put_back
        "$here/scripts/binds" --compositor hyprland --record
        echo "wrote     $binds"
    else
        moved="$(repoint "$binds")"
        [ -n "$moved" ] && echo "pointed   $binds from $moved to $here"
        "$here/scripts/hypr-include" binds <"$binds" || put_back
        "$here/scripts/binds" --compositor hyprland || true
        echo "kept      $binds (yours; --force writes it again)"
    fi
    if $autostart; then
        printf -- '-- Bioma, started with the session (scripts/install --autostart).\nhl.on("hyprland.start", function()\n    hl.exec_cmd(%s)\nend)\n' \
            "\"'$here/scripts/shell' start\"" | "$here/scripts/hypr-include" autostart || put_back
        echo "wrote     $hdir/bioma-autostart.lua"
    fi
    if refusal="$(env -u HYPRLAND_INSTANCE_SIGNATURE Hyprland --verify-config -c "$config" 2>&1)" && ! printf '%s' "$refusal" | grep -q 'error\|unknown config key'; then
        if cmp -s "$backup" "$real"; then rm -f "$backup"; else echo "hyprland.lua was changed; the previous one is $backup"; fi
        echo "Hyprland accepts the configuration."
    else
        cp -p "$backup" "$real"
        echo "Hyprland refused the result, so hyprland.lua is back as it was:" >&2
        printf '%s\n' "$refusal" | grep -m3 -E 'error|unknown|attempt' >&2
        exit 1
    fi
    echo
    echo "Start Bioma with $here/scripts/shell bioma — or log in again, with --autostart."
    exit 0
fi

if [ "$compositor" = umbriel ]; then
    udir="${XDG_CONFIG_HOME:-$HOME/.config}/umbriel"
    config="$udir/config.toml"
    if [ ! -f "$config" ]; then
        if [ ! -f /usr/share/umbriel/config.toml ]; then
            echo "No Umbriel configuration at $config, and none packaged to start from." >&2
            exit 1
        fi
        mkdir -p "$udir"
        cp /usr/share/umbriel/config.toml "$config"
        echo "copied    Umbriel's starting configuration to $config"
    fi
    real="$(readlink -f "$config")"
    backup="$real.before-bioma.$(date +%Y%m%d-%H%M%S)"
    cp -p "$real" "$backup"
    put_back() { cp -p "$backup" "$real"; echo "Umbriel refused it, so config.toml is back as it was." >&2; exit 1; }
    binds="$udir/bioma-binds.toml"
    if [ ! -f "$binds" ] || $force; then
        sed "s#@BIOMA@#$here#g" "$here/config/umbriel/bioma-binds.toml.in" | "$here/scripts/umbriel-include" binds || put_back
        "$here/scripts/binds" --compositor umbriel --record
        echo "wrote     $binds"
    else
        moved="$(repoint "$binds")"
        [ -n "$moved" ] && echo "pointed   $binds from $moved to $here"
        "$here/scripts/umbriel-include" binds <"$binds" || put_back
        "$here/scripts/binds" --compositor umbriel || true
        echo "kept      $binds (yours; --force writes it again)"
    fi
    if $autostart; then
        # A list: Umbriel takes the last file's whole, so it is config.toml's
        # own, Bioma's command added to what is there (or pointed here).
        python3 - "$real" "'$here/scripts/shell' start" <<'PY' || put_back
import json, re, sys
path, command = sys.argv[1], sys.argv[2]
lines = open(path).read().split("\n")
quoted = json.dumps(command)
general = next((i for i, l in enumerate(lines) if re.match(r"\s*\[general\]\s*(#.*)?$", l)), None)
if general is None:
    lines += ["", "[general]", "autostart = [" + quoted + "]"]
else:
    end = next((i for i in range(general + 1, len(lines)) if re.match(r"\s*\[", lines[i])), len(lines))
    at = next((i for i in range(general + 1, end) if re.match(r"\s*autostart\s*=\s*\[.*\]", lines[i])), None)
    if at is None:
        lines.insert(general + 1, "autostart = [" + quoted + "]")
    else:
        line = lines[at]
        open_at, close_at = line.index("["), line.rindex("]")
        items = [x for x in re.findall(r'"(?:[^"\\]|\\.)*"', line[open_at:close_at]) if "/scripts/shell" not in x]
        lines[at] = line[:open_at] + "[" + ", ".join(items + [quoted]) + line[close_at:]
text = "\n".join(lines)
if text != open(path).read():
    open(path, "w").write(text)
    print("added     Bioma to general.autostart")
PY
    fi
    if refusal="$(env -u UMBRIEL_SOCKET umbriel config validate -c "$config" 2>&1)"; then
        if cmp -s "$backup" "$real"; then rm -f "$backup"; else echo "config.toml was changed; the previous one is $backup"; fi
        echo "Umbriel accepts the configuration."
    else
        cp -p "$backup" "$real"
        echo "Umbriel refused the result, so config.toml is back as it was:" >&2
        printf '%s\n' "$refusal" | tail -3 >&2
        exit 1
    fi
    echo
    echo "Start Bioma with $here/scripts/shell bioma — or log in again, with --autostart."
    exit 0
fi

# ---- niri ------------------------------------------------------------------------

config="${NIRI_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/niri/config.kdl}"
if [ ! -f "$config" ]; then
    echo "No niri configuration at $config — start niri once, or set NIRI_CONFIG." >&2
    exit 1
fi
real="$(readlink -f "$config")"
dir="$(dirname "$real")"
binds="$dir/bioma-binds.kdl"

backup="$real.before-bioma.$(date +%Y%m%d-%H%M%S)"
cp -p "$real" "$backup"

if [ ! -f "$binds" ] || $force; then
    sed "s#@BIOMA@#$here#g" "$here/config/niri/bioma-binds.kdl.in" >"$binds"
    "$here/scripts/binds" --record
    echo "wrote     $binds"
else
    echo "kept      $binds (yours; --force writes it again)"
    # Yours, but it may name another Bioma: the clone before a package, or a
    # repository that moved. Its keys stay; only the path in them changes.
    moved="$(python3 - "$binds" "$here" <<'PY'
import re, sys
path, here = sys.argv[1], sys.argv[2]
text = open(path).read()
roots = set(re.findall(r'"([^"]+)/shell\.qml"', text)) | set(re.findall(r'"([^"]+)/scripts/[a-z-]+"', text))
roots.discard(here)
for root in roots:
    text = text.replace(f'"{root}/', f'"{here}/')
if roots:
    open(path, "w").write(text)
print(" ".join(sorted(roots)))
PY
)"
    [ -n "$moved" ] && echo "pointed   $binds from $moved to $here"
    # Keys a later version brought, which a copy from before it lacks.
    "$here/scripts/binds" || true
fi

# An include of the repository's own binds file predates the template: it is
# the same keys, read from the repository, so it becomes the written copy.
old="include \"$here/config/niri/bioma-binds.kdl\""
if grep -qF "$old" "$real"; then
    sed -i "s#^\([[:space:]]*\)include \"$here/config/niri/bioma-binds.kdl\"#\1include \"bioma-binds.kdl\"#" "$real"
    echo "replaced  the include of $here/config/niri/bioma-binds.kdl"
fi

ensure() {   # a line, and a pattern that finds it already there
    if ! grep -qE "$2" "$real"; then
        printf '\n%s\n' "$1" >>"$real"
        echo "added     $1"
        return
    fi
    # There, but pointing somewhere else: a clone the package has replaced,
    # or a repository that moved. Left alone, niri would go on reading the old
    # copy, and the login would start it. The line is rewritten in place.
    if ! grep -qxF "$1" <(sed 's/^[[:space:]]*//; s/[[:space:]]*$//' "$real"); then
        python3 - "$real" "$2" "$1" <<'PY'
import re, sys
path, pattern, line = sys.argv[1], sys.argv[2].replace("[[:space:]]", r"\s"), sys.argv[3]
text = open(path).read().split("\n")
out = [(re.match(r"\s*", l).group(0) + line) if re.search(pattern, l) else l for l in text]
open(path, "w").write("\n".join(out))
PY
        echo "pointed   $1"
    fi
}

ensure "include \"$here/config/niri/bioma.kdl\"" \
       "^[[:space:]]*include[[:space:]]+\"[^\"]*/config/niri/bioma\.kdl\""
ensure "include \"bioma-binds.kdl\"" \
       "^[[:space:]]*include[[:space:]]+\"(.*/)?bioma-binds\.kdl\""
if $autostart; then
    ensure "spawn-at-startup \"$here/scripts/shell\" \"start\"" \
           "^[[:space:]]*spawn-at-startup[[:space:]]+\"[^\"]*/scripts/shell\"[[:space:]]+\"start\""
fi

if refusal="$(niri validate -c "$config" 2>&1)"; then
    if cmp -s "$backup" "$real"; then
        rm -f "$backup"
    else
        echo "config.kdl was changed; the previous one is $backup"
    fi
    echo "niri accepts the configuration."
else
    cp -p "$backup" "$real"
    echo "niri refused the result, so config.kdl is back as it was:" >&2
    printf '%s\n' "$refusal" | sed 's/\x1b\[[0-9;]*m//g' | tail -5 >&2
    exit 1
fi

echo
echo "Start Bioma with $here/scripts/shell bioma — or log in again, with --autostart."
