{
  "$comment": "Settings and system alone, at the right end of the top membrane, to compose from. The notifications and the launcher stay as floating tissues: both are invisible at rest, and without the notification cell Bioma would own the notification name and show nothing.",
  "name": "Empty",
  "order": 2,
  "line": "Settings and system only, to compose from.",
  "membranes": [
    {
      "monitor": "primary",
      "edge": "top",
      "reserve_space": true,
      "auto_hide": false,
      "scale": "normal",
      "tissues": [
        {
          "anchor": "end",
          "percentage": 30,
          "growth": "inward",
          "orientation": "horizontal",
          "cells": [
            {
              "type": "settings",
              "enabled": true,
              "visibility": {
                "type": "always",
                "shortcut": "Mod+Comma"
              },
              "min_width": {
                "value": 40
              }
            },
            {
              "type": "system",
              "enabled": true,
              "visibility": {
                "type": "always",
                "shortcut": "Mod+Escape"
              },
              "min_width": {
                "value": 40
              }
            }
          ]
        }
      ]
    }
  ],
  "floating": [
    {
      "anchor": "top-right",
      "margins": {
        "top": 12,
        "right": 12
      },
      "orientation": "vertical",
      "$comment": "Two notification cells in a column: a critical one sits on top and does not leave by itself, and the ordinary ones keep going past it underneath. One block with no `options.show` shows everything, urgent first.",
