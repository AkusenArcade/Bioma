            "exit": 1,
            "confirm": 0,
            "dwell": 400
          },
          "min_width": {
            "value": 220
          },
          "width": {
            "max": 300
          }
        },
        {
          "type": "notifications",
          "options": {
            "show": "ordinary"
          },
          "enabled": true,
          "visibility": {
            "type": "conditional",
            "enter": 1,
            "exit": 1,
            "confirm": 0,
            "dwell": 400
          },
          "min_width": {
            "value": 220
          },
          "width": {
            "max": 300
          }
        }
      ]
    },
    {
      "anchor": "center",
      "orientation": "vertical",
      "cells": [
        {
          "type": "launcher",
          "enabled": true,
          "visibility": {
            "type": "invoked",
