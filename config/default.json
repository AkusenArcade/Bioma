{
  "$comment": "Bioma base layer. Hand-written, version-controlled. The settings UI writes an override file which is loaded last and wins. Structural terms are biological: membrane (an edge of a monitor), tissue (a container on it), cell (a unit of content, never a grid cell). Each key is explained in docs/configuration.md, because JSON has no comments.",

  "appearance": {
    "radius": 100,
    "edge": 12,
    "gap": 24
  },

  "cell": {
    "opacity": 0.72,
    "blur": true
  },

  "tissue": {
    "opacity": 0.50,
    "padding": 2
  },
  "scrim": {
    "opacity": 0.85,
    "reach": 32
  },

  "fonts": {
    "expressive": "Spectral",
    "technical": "Orbitron"
  },

  "theme": {
    "source": "manual",
    "palette": "default",
    "matugen": {
      "variant": "dark",
      "scheme": "scheme-tonal-spot",
      "source_color_index": 0
    },
    "state": {
      "dark":  { "calm": "#6EE7A6", "active": "#F2C14E", "alert": "#FF6B5D" },
      "light": { "calm": "#2E9C6A", "active": "#B37414", "alert": "#C43A2E" }
    }
  },

  "timing": {
    "speed": 1.0,
    "open": 250,
    "close": 150,
    "grow": 100,
    "stagger": 16,
    "transition": 180,
    "debounce": 180,
    "reflow": 220,
    "theme": 250,
    "auto_hide": 500,
    "notification": 5000,
    "content_fade": 120,
    "loader": 1200,
    "wallpaper": 600,
    "welcome": 900,
    "welcome_open": 450,
    "welcome_stagger": 100,
    "welcome_fade": 1000
  },

  "wallpaper": {
    "folder": "$HOME/Pictures/Wallpapers",
    "thumbnails": true,
    "picker": "carousel"
  },

  "audio": {
    "monitor_signal": true,
    "step": 0.05
  },

  "sinestesia": {
    "bands": 64,
    "fps": 60,
    "gain": 1.0,
    "source": "output"
  },

  "brightness": {
    "backend": "auto",
    "display": ""
  },

  "capture": {
    "folder": "$HOME/Pictures/Screenshots",
    "video_folder": "$HOME/Videos/Recordings",
    "clipboard": true,
    "notify": true,
    "ocr_language": "eng",
    "what": "image",
    "from": "screen",
    "fps": 60,
    "codec": "avc",
    "bitrate": "5 MB",
    "dictation": {
      "model": "/usr/share/whisper.cpp-model-large-v3-turbo-q5_0/ggml-large-v3-turbo-q5_0.bin",
      "language": "auto",
      "max_seconds": 120,
      "terminals": ["Alacritty", "foot", "footclient", "kitty", "com.mitchellh.ghostty",
                    "org.wezfurlong.wezterm", "org.kde.konsole", "org.gnome.Console",
                    "org.gnome.Ptyxis", "xterm"]
    }
  },

  "notifications": {
    "$comment": "The temporal grammar of what other programs have to say. Dwell is by urgency and critical never expires, as the freedesktop convention requires. Past the cap a burst stops queueing and becomes a count.",
    "quiet": false,
    "dwell_low": 4000,
    "dwell_normal": 8000,
    "queue_cap": 20,
    "burst_window": 10000,
    "history": 100
  },

  "dock": {
    "$comment": "Applications kept on the dock, by desktop entry id, in the order they are shown. With none the dock is a window list, which is a legitimate way to use it.",
    "pinned": [],
    "launcher": false
  },

  "session": {
    "$comment": "Each command is a list: the program and its arguments. None of these is universal — a lock screen is a choice, systemd is not the only init, and leaving the session is a different sentence on every compositor.",
    "lock": ["loginctl", "lock-session"],
    "suspend": ["systemctl", "suspend"],
    "restart": ["systemctl", "reboot"],
    "shutdown": ["systemctl", "poweroff"],
    "logout": ["niri", "msg", "action", "quit", "-s"]
  },

  "lock": {
    "$comment": "Bioma's lock screen: lock.qml, started and guarded by scripts/lock. It locks when asked (session.lock, Mod+Alt+L), before a suspend, and after idle_minutes without input (0 never). If it fails, hyprlock or swaylock takes over.",
    "idle_minutes": 10,
    "before_sleep": true
  },

  "power": {
    "$comment": "The power profile to switch to when the machine goes on battery and when it is plugged in again: saver, balanced, performance, or keep to leave it alone. Needs a battery and power-profiles-daemon (or tuned-ppd). A profile chosen by hand holds until the power source next changes.",
    "on_battery": "keep",
    "on_mains": "keep"
  },

  "vitals": {
    "interval": 2000,
    "clock_average": 5,
    "gpu_card": "",
    "temperature_sensor": "",
    "process_interval": 3000,
    "process_count": 60
  },

  "membranes": [
    {
      "monitor": "primary",
      "edge": "top",
      "reserve_space": true,
      "auto_hide": false,
      "scale": "normal",
      "tissues": [
        {
          "percentage": 30,
          "growth": "inward",
          "orientation": "horizontal",
          "cells": [
            {
              "type": "workspaces",
              "enabled": true,
              "visibility": { "type": "always" },
              "min_width": { "value": 96 },
              "width": { "max": 220 }
            },
            {
              "type": "window_title",
              "enabled": true,
              "visibility": { "type": "conditional", "enter": 1, "exit": 1, "confirm": 0, "dwell": 200 },
              "min_width": { "value": 0 },
              "width": { "elastic": true, "max_percent": 28 }
            }
          ]
        },
        {
          "percentage": 20,
          "growth": "symmetric",
          "orientation": "horizontal",
          "cells": [
            {
              "type": "sinestesia",
              "enabled": true,
              "visibility": {
                "type": "conditional",
                "enter": 0.02,
                "exit": 0.005,
                "confirm": 200,
                "dwell": 4000
              },
              "min_width": { "value": 81 },
              "width": { "elastic": true, "max_percent": 22 }
            }
          ]
        },
        {
          "percentage": 30,
          "growth": "inward",
          "orientation": "horizontal",
          "cells": [
            {
              "type": "vitals",
              "enabled": true,
              "visibility": { "type": "always", "shortcut": "Mod+V" },
              "min_width": { "value": 90 },
              "options": { "gpu": true, "process_sort": "ram" }
            },
            {
              "type": "utility",
              "enabled": true,
              "visibility": { "type": "always", "shortcut": "Mod+P" },
              "min_width": { "value": 40 }
            },
            {
              "type": "theme",
              "enabled": true,
              "visibility": { "type": "always", "shortcut": "Mod+T" },
              "min_width": { "value": 120 }
            },
            {
              "type": "connectivity",
              "enabled": true,
              "visibility": { "type": "conditional", "enter": 1, "exit": 1, "confirm": 0, "dwell": 1000 },
              "min_width": { "value": 64 }
            },
            {
              "type": "tray",
              "enabled": true,
              "visibility": { "type": "conditional", "enter": 1, "exit": 1, "confirm": 0, "dwell": 1000 },
              "min_width": { "value": 40 }
            },
            {
              "type": "audio",
              "enabled": true,
              "visibility": { "type": "always", "shortcut": "Mod+A" },
              "min_width": { "value": 40 }
            },
            {
              "type": "settings",
              "enabled": true,
              "visibility": { "type": "always", "shortcut": "Mod+Comma" },
              "min_width": { "value": 40 }
            },
            {
              "type": "system",
              "enabled": true,
              "visibility": { "type": "always", "shortcut": "Mod+Escape" },
              "min_width": { "value": 40 }
            }
          ]
        }
      ]
    },
    {
      "monitor": "primary",
      "edge": "bottom",
      "reserve_space": false,
      "auto_hide": true,
      "scale": "normal",
      "tissues": [
        {
          "percentage": 40,
          "growth": "symmetric",
          "orientation": "horizontal",
          "cells": [
            {
              "type": "dock",
              "enabled": true,
              "visibility": { "type": "conditional", "enter": 1, "exit": 1, "confirm": 0, "dwell": 400 },
              "min_width": { "value": 52 }
            }
          ]
        }
      ]
    }
  ],

  "floating": [
    {
      "anchor": "top-right",
      "margins": { "top": 12, "right": 12 },
      "orientation": "vertical",
      "$comment": "Two notification cells in a column: a critical one sits on top and does not leave by itself, and the ordinary ones keep going past it underneath. One block with no `options.show` shows everything, urgent first.",
      "cells": [
        {
          "type": "notifications",
          "options": { "show": "urgent" },
          "enabled": true,
          "visibility": { "type": "conditional", "enter": 1, "exit": 1, "confirm": 0, "dwell": 400 },
          "min_width": { "value": 220 },
          "width": { "max": 300 }
        },
        {
          "type": "notifications",
          "options": { "show": "ordinary" },
          "enabled": true,
          "visibility": { "type": "conditional", "enter": 1, "exit": 1, "confirm": 0, "dwell": 400 },
          "min_width": { "value": 220 },
          "width": { "max": 300 }
        }
      ]
    },
    {
      "anchor": "center",
      "orientation": "vertical",
      "cells": [
        {
          "type": "launcher",
          "enabled": true,
          "visibility": { "type": "invoked", "shortcut": "Mod+Space" },
          "min_width": { "value": 480 }
        }
      ]
    }
  ],
  "organisms": []
}
