# Bioma — the keys that ask for a cell, for Umbriel (bioma-binds.kdl.in is
# niri's, bioma-binds.lua.in Hyprland's, with the same keys).
#
# The compositor holds the keys and the shell holds the cells, and the whole
# of the connection is one IPC call: `scripts/ipc cell toggle <domain>` asks
# the register for a cell of that domain and toggles it. Ask the running
# shell which domains it knows:
#
#     /path/to/Bioma/scripts/ipc cell list
#
# **This is a template.** It is written out as `bioma-binds.toml` beside
# Umbriel's `config.toml`, with `@BIOMA@` replaced by where Bioma actually
# is, and included from it (`scripts/umbriel-include`). The written copy is
# yours: one bind a line, so the settings cell's Keybinds page can edit it in
# place. The comment at a line's end is the bind's name on that page.
#
# **The prefix is Super+Alt**, as on niri: the plain Super keys are the
# compositor's own.
#
# Umbriel merges `[keybinds]` key by key and lets config.toml win, whatever
# order the files come in. So a key bound here is taken out of config.toml's
# own `[keybinds]` when this file is included, the line kept as a comment
# that says why: as on niri, a key Bioma binds is Bioma's.

[keybinds]
"Super+Alt+V" = "spawn '@BIOMA@/scripts/ipc' cell toggle vitals" # Bioma: vitals
"Super+Alt+P" = "spawn '@BIOMA@/scripts/ipc' cell toggle utility" # Bioma: capture
"Super+Alt+K" = "spawn '@BIOMA@/scripts/ipc' cell toggle keyboard" # Bioma: keyboard
"Super+Shift+Space" = { action = "keyboard-layout-next", repeat = false } # Next keyboard layout
"Super+Alt+T" = "spawn '@BIOMA@/scripts/ipc' cell toggle theme" # Bioma: theme
"Super+Alt+A" = "spawn '@BIOMA@/scripts/ipc' cell toggle audio" # Bioma: audio
"Super+Alt+S" = "spawn '@BIOMA@/scripts/ipc' cell toggle settings" # Bioma: settings
"Super+Alt+Escape" = "spawn '@BIOMA@/scripts/ipc' cell toggle system" # Bioma: system
"XF86AudioRaiseVolume" = { action = "spawn '@BIOMA@/scripts/key' volume-up", allow_when_locked = true } # Volume up
"XF86AudioLowerVolume" = { action = "spawn '@BIOMA@/scripts/key' volume-down", allow_when_locked = true } # Volume down
"XF86AudioMute" = { action = "spawn '@BIOMA@/scripts/key' mute", allow_when_locked = true, repeat = false } # Mute
"XF86AudioMicMute" = { action = "spawn '@BIOMA@/scripts/key' mic-mute", allow_when_locked = true, repeat = false } # Microphone mute
"XF86MonBrightnessUp" = { action = "spawn '@BIOMA@/scripts/key' brightness-up", allow_when_locked = true } # Brightness up
"XF86MonBrightnessDown" = { action = "spawn '@BIOMA@/scripts/key' brightness-down", allow_when_locked = true } # Brightness down
"XF86AudioPlay" = { action = "spawn '@BIOMA@/scripts/key' media-toggle", repeat = false } # Media: play or pause
"XF86AudioNext" = { action = "spawn '@BIOMA@/scripts/key' media-next", repeat = false } # Media: next
"XF86AudioPrev" = { action = "spawn '@BIOMA@/scripts/key' media-previous", repeat = false } # Media: previous
"XF86AudioStop" = { action = "spawn '@BIOMA@/scripts/key' media-stop", repeat = false } # Media: stop
"Print" = { action = "spawn '@BIOMA@/scripts/ipc' capture region", repeat = false } # Bioma: screenshot of a region
"Super+Print" = { action = "spawn '@BIOMA@/scripts/ipc' capture screen", repeat = false } # Bioma: screenshot of the screen
"Alt+Print" = { action = "spawn '@BIOMA@/scripts/ipc' capture window", repeat = false } # Bioma: screenshot of the window
"Super+Alt+C" = { action = "spawn '@BIOMA@/scripts/ipc' capture colour", repeat = false } # Bioma: pick a colour
"Shift+Print" = { action = "spawn '@BIOMA@/scripts/ipc' capture stop", repeat = false } # Bioma: stop recording
"Super+Alt+D" = { action = "spawn '@BIOMA@/scripts/ipc' capture dictate", repeat = false } # Bioma: dictation
"Super+Space" = { action = "spawn '@BIOMA@/scripts/ipc' cell toggle launcher", repeat = false } # Bioma: launcher
"Super+Alt+Space" = { action = "spawn '@BIOMA@/scripts/ipc' cell toggle actions", repeat = false } # Bioma: quick actions
"Super+Alt+MouseMiddle" = "spawn '@BIOMA@/scripts/ipc' actions ring" # Bioma: quick actions
"Super+Alt+Period" = { action = "spawn '@BIOMA@/scripts/ipc' cell toggle emoji", repeat = false } # Bioma: emoji
"Super+Alt+G" = { action = "spawn '@BIOMA@/scripts/ipc' performance toggle", repeat = false } # Bioma: performance mode
"Super+Alt+F" = { action = "spawn '@BIOMA@/scripts/ipc' focus toggle", repeat = false } # Bioma: focus mode
"Super+Alt+L" = { action = "spawn '@BIOMA@/scripts/lock'", repeat = false } # Bioma: lock
"Super+Alt+B" = { action = "spawn '@BIOMA@/scripts/shell' toggle", repeat = false } # Bioma: switch shell
