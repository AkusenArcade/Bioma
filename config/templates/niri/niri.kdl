// Bioma: the focused window's ring is lit the way a cell's rim is — the light
// at the top, from above and slightly from the left (the style guide's 165°),
// falling to the outline colour below. At the primary the ring read thicker
// than a cell's 1 px edge only because it was brighter.
layout {

    focus-ring {
        active-color    "{{colors.primary.default.hex}}"
        active-gradient from="{{colors.rim.default.hex}}" to="{{colors.outline.default.hex}}" angle=165 relative-to="window"
        inactive-color  "{{colors.surface.default.hex}}"
        urgent-color    "{{colors.error.default.hex}}"
    }

    border {
        active-color    "{{colors.primary.default.hex}}"
        active-gradient from="{{colors.rim.default.hex}}" to="{{colors.outline.default.hex}}" angle=165 relative-to="window"
        inactive-color  "{{colors.surface.default.hex}}"
        urgent-color    "{{colors.error.default.hex}}"
    }


    // The focused window is raised the way an invoked cell is: the style
    // guide's shadow, 28 soft at 45 % (22 % on a light palette). A 1 px ring
    // can vanish into a wallpaper of its own colour; elevation still says which
    // window has the focus. The others lie flat, like contracted cells.
    // Centred, not dropped 14 below as a cell's is: the shadow is there to set
    // the ring off the wallpaper, and the ring is lit at the top.
    shadow {
        on
        softness 28
        spread 0
        offset x=0 y=0
        color "{{bioma.window_shadow}}"
        inactive-color "#00000000"
    }

    tab-indicator {
        active-color   "{{colors.primary.default.hex}}"
        inactive-color "{{colors.primary_container.default.hex}}"
        urgent-color   "{{colors.error.default.hex}}"
    }

    insert-hint {
        color "{{colors.primary.default.hex}}80"
    }
}

recent-windows {
    highlight {
        active-color "{{colors.primary.default.hex}}"
        urgent-color "{{colors.error.default.hex}}"
    }
}

// Bioma: the windows take the shell's corner radius — 20 px at 100 % of the
// RADIUS slider in the settings cell, and in proportion below it. Written last
// in the file that is included last, so it overrides a radius set earlier.
window-rule {
    geometry-corner-radius {{bioma.window_radius}}
    clip-to-geometry true
}
