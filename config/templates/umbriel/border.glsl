// Generated by Bioma: the focused window's border, lit from above and slightly
// from the left (the style guide's 165 degrees), from the rim's colour down to
// the outline's, as a cell's rim is. Nothing here reads the time.
vec4 border(vec2 uv) {
  float ring = umbriel_sample(uv).a;
  // A window rule's opacity is the ring's too: taken off, so that the wallpaper
  // does not tint the light. Read in the middle of the top edge, one pixel in.
  float opacity = umbriel_sample(vec2(0.5, 1.0 / umbriel_size.y)).a;
  float cover = opacity > 0.05 ? clamp(ring / opacity, 0.0, 1.0) : ring;
  vec2 p = (uv - 0.5) * umbriel_size;
  vec2 d = vec2(0.2588, 0.9659);
  float span = abs(umbriel_size.x * d.x) + abs(umbriel_size.y * d.y);
  float t = clamp(dot(p, d) / span + 0.5, 0.0, 1.0);
  vec3 rim = vec3({{colors.rim.default.rgb_csv}}) / 255.0;
  vec3 outline = vec3({{colors.outline.default.rgb_csv}}) / 255.0;
  return vec4(mix(rim, outline, t) * cover, cover);
}
