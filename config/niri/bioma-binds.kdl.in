// Bioma — the keys that ask for a cell.
//
// The compositor holds the keys and the shell holds the cells, and the whole
// of the connection is one IPC call: `qs ipc call cell toggle <domain>` asks
// the register for a cell of that domain and toggles it. There is no second
// model for invoked surfaces — a launcher, a session menu and a settings page
// are cells whose visibility is `invoked`, and they arrive the same way the
// always-visible ones open (PRD §5).
//
// The domain is the `type` in the configuration, and every cell answers: on a
// membrane it opens where it is, in a floating slot it appears there, and
// placed nowhere on the monitor it comes up in the middle. Ask the running
// shell which domains it knows:
//
//     qs -p /path/to/Bioma/shell.qml ipc call cell list
//
// **This is a template.** `scripts/install` writes it out as
// `bioma-binds.kdl` beside niri's `config.kdl`, with `@BIOMA@` replaced by
// where the repository actually is, and includes it. The written copy is
// yours: the settings cell's Keybinds page edits it in place, and the
// installer does not overwrite it again unless asked to (`--force`).
//
// niri merges an included `binds` block with its own, so nothing here has to
// be repeated there.
//
// **The prefix is Mod+Alt.** niri's own default configuration already uses the
// plain keys a shell would want — Mod+T is the terminal, Mod+V and Mod+Escape
// are taken — and two bindings on one key is not a thing to ship. The
// `shortcut` strings in `config/default.json` are the plain keys the cells
// were drawn with; move a bind there from the Keybinds page if the key is free
// on your machine.

binds {
    Mod+Alt+V hotkey-overlay-title="Bioma: vitals" {
        spawn "qs" "-p" "@BIOMA@/shell.qml" "ipc" "call" "cell" "toggle" "vitals"
    }

    Mod+Alt+P hotkey-overlay-title="Bioma: capture" {
        spawn "qs" "-p" "@BIOMA@/shell.qml" "ipc" "call" "cell" "toggle" "utility"
    }

    Mod+Alt+K hotkey-overlay-title="Bioma: keyboard" {
        spawn "qs" "-p" "@BIOMA@/shell.qml" "ipc" "call" "cell" "toggle" "keyboard"
    }

    // The next layout, straight from niri: the keyboard cell shows which one
    // it is, when it is placed conditional.
    Mod+Shift+Space hotkey-overlay-title="Next keyboard layout" { switch-layout "next"; }

    Mod+Alt+T hotkey-overlay-title="Bioma: theme" {
        spawn "qs" "-p" "@BIOMA@/shell.qml" "ipc" "call" "cell" "toggle" "theme"
    }

    Mod+Alt+A hotkey-overlay-title="Bioma: audio" {
        spawn "qs" "-p" "@BIOMA@/shell.qml" "ipc" "call" "cell" "toggle" "audio"
    }

    Mod+Alt+S hotkey-overlay-title="Bioma: settings" {
        spawn "qs" "-p" "@BIOMA@/shell.qml" "ipc" "call" "cell" "toggle" "settings"
    }

    Mod+Alt+Escape hotkey-overlay-title="Bioma: system" {
        spawn "qs" "-p" "@BIOMA@/shell.qml" "ipc" "call" "cell" "toggle" "system"
    }

    // ---- The keys that are not cells ------------------------------------
    //
    // Volume, brightness and the transport act on the machine without opening
    // anything, so they do not go through the cell register. `scripts/key`
    // sends each one to whichever shell is running, which is what keeps them
    // working across the switch — the same keys were Noctalia's and are
    // commented out in its own binds file, because two bindings on one key is
    // not a thing to leave lying around.

    XF86AudioRaiseVolume allow-when-locked=true {
        spawn "@BIOMA@/scripts/key" "volume-up"
    }

    XF86AudioLowerVolume allow-when-locked=true {
        spawn "@BIOMA@/scripts/key" "volume-down"
    }

    XF86AudioMute allow-when-locked=true {
        spawn "@BIOMA@/scripts/key" "mute"
    }

    XF86AudioMicMute allow-when-locked=true {
        spawn "@BIOMA@/scripts/key" "mic-mute"
    }

    XF86MonBrightnessUp allow-when-locked=true {
        spawn "@BIOMA@/scripts/key" "brightness-up"
    }

    XF86MonBrightnessDown allow-when-locked=true {
        spawn "@BIOMA@/scripts/key" "brightness-down"
    }

    XF86AudioPlay hotkey-overlay-title="Media: play or pause" {
        spawn "@BIOMA@/scripts/key" "media-toggle"
    }

    XF86AudioNext hotkey-overlay-title="Media: next" {
        spawn "@BIOMA@/scripts/key" "media-next"
    }

    XF86AudioPrev hotkey-overlay-title="Media: previous" {
        spawn "@BIOMA@/scripts/key" "media-previous"
    }

    XF86AudioStop hotkey-overlay-title="Media: stop" {
        spawn "@BIOMA@/scripts/key" "media-stop"
    }

    // A screenshot without opening anything: Print draws a region with
    // Bioma's own rectangle, Mod+Print takes the whole monitor the keyboard is
    // on. Both go to the screenshots folder and the clipboard, like the
    // utility cell's. They replace niri's own `Print { screenshot; }`, because
    // this file is included after it.
    Print hotkey-overlay-title="Bioma: screenshot of a region" {
        spawn "qs" "-p" "@BIOMA@/shell.qml" "ipc" "call" "capture" "region"
    }

    Mod+Print hotkey-overlay-title="Bioma: screenshot of the screen" {
        spawn "qs" "-p" "@BIOMA@/shell.qml" "ipc" "call" "capture" "screen"
    }

    // The launcher has no place of its own: asked for, it is built in the
    // middle of the screen the keyboard is pointed at.
    Mod+Space hotkey-overlay-title="Bioma: launcher" {
        spawn "qs" "-p" "@BIOMA@/shell.qml" "ipc" "call" "cell" "toggle" "launcher"
    }

    // Not a cell: the shell itself. One of the two runs at a time, because
    // one program per session may own the notification bus — see
    // `scripts/shell` for the other one it switches to.
    Mod+Alt+B hotkey-overlay-title="Bioma: switch shell" {
        spawn "@BIOMA@/scripts/shell" "toggle"
    }
}
