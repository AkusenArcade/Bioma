// Bioma — layer rules for niri.
//
// Blur itself needs no rule: niri turns it on by itself for a surface that
// declares a blur region through `ext-background-effect`, which is how Bioma
// asks for it — the exact shape of each cell and nothing else.
//
// What does need saying is `xray false`, for every surface Bioma blurs, so
// that each shows what is really underneath it. niri defaults xray to true
// whenever a background effect is visible, and on niri 26.04 xray paints the
// backdrop over the whole layer surface rather than the declared blur region.
// A membrane's surface is as tall as the screen, to hold the panels that hang
// from it, so xray there covered every window with the wallpaper (tried as a
// setting, 2026-09-29). The floating tissues had no rule and blurred the
// wallpaper while the membranes blurred the windows; one rule now.

layer-rule {
    match namespace="^bioma-(membrane-.+|float|osd)$"
    background-effect {
        xray false
    }
}

// The overview. niri draws background-layer surfaces inside each workspace, so
// when the workspaces shrink into the overview the wallpaper shrinks with them
// and the space around them is niri's flat backdrop colour. Bioma puts a
// blurred copy of the wallpaper on a surface of its own, and this places that
// surface in the backdrop instead of in a workspace.
layer-rule {
    match namespace="^bioma-backdrop$"
    place-within-backdrop true
}
