{
  "$comment": "Bioma's cursors as data: the drawn source scripts/cursors renders into XCursor themes, and docs/design/pages/cursors.html draws for review. Keep the copy embedded in that page identical. The grammar and the decisions are docs/design/CURSORS.md.",

  "grid": 24,
  "outline": 1.25,
  "line": 1.6,
  "halo": 1.1,
  "badge_shift": [0.8, 1.0],
  "sizes": [24, 32, 48, 64, 72, 96],

  "loader": {
    "$comment": "How many steps the XCursor animation takes through one loader cycle. The cycle's length and easing are core/Timing.qml's loader and sweep, sent by the shell.",
    "frames": 24
  },

  "themes": {
    "bioma": {
      "name": "Bioma",
      "comment": "Background body, text contour; the primary is only the node.",
      "inks": { "fill": "background", "outline": "text", "line": "text", "halo": "background", "ink": "text", "accent": "primary" }
    },
    "bioma-cell": {
      "name": "Bioma Cell",
      "comment": "Cell body, rim contour lit from above, like a contracted cell.",
      "inks": { "fill": "cell", "outline": "@rim", "line": "rim", "halo": "background", "ink": "rim", "accent": "primary" }
    }
  },

